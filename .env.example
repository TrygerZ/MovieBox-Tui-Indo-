# ============================================================
#  MovieBox-Tui — OpenSubtitles (subtitle Indonesia)
#  TEMPLATE — salin file ini menjadi `.env` lalu isi kredensial:
#    cp .env.example .env     (Linux/macOS)
#    copy .env.example .env   (Windows)
#  Registrasi gratis: https://www.opensubtitles.com/
#  (Dapatkan API key di https://opensubtitles.com/support/faq)
# ============================================================

# API key (opsional tapi disarankan) — dari panel akun OpenSubtitles
MOVIEBOX_OPENSUBTITLES_API_KEY=	

# Username & password akun OpenSubtitles (WAJIB untuk login)
MOVIEBOX_OPENSUBTITLES_USERNAME=
MOVIEBOX_OPENSUBTITLES_PASSWORD=

# Aktifkan fitur (default: true). Set "false" untuk menonaktifkan total.
MOVIEBOX_OPENSUBTITLES_ENABLED=true

# Daftar bahasa dipisah koma, urutan prioritas (default: id,en)
MOVIEBOX_OPENSUBTITLES_LANGUAGES=id,en

# Opsional: override endpoint API (untuk pengujian/mirror). Kosongkan = default resmi.
# MOVIEBOX_OPENSUBTITLES_BASE_URL=
