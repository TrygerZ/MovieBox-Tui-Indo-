# ============================================================
#  MovieBox-Tui — OpenSubtitles (subtitle Indonesia)
#  TEMPLATE — salin file ini menjadi `.env` lalu isi kredensial:
#    cp .env.example .env     (Linux/macOS)
#    copy .env.example .env   (Windows)
#  Registrasi gratis: https://www.opensubtitles.com/
#  (Dapatkan API key di https://opensubtitles.com/support/faq)
# ============================================================

# API key (opsional tapi disarankan) — dari panel akun OpenSubtitles
MOVIEBOX_OPENSUBTITLES_API_KEY=	

# Username & password akun OpenSubtitles (WAJIB untuk login)
MOVIEBOX_OPENSUBTITLES_USERNAME=
MOVIEBOX_OPENSUBTITLES_PASSWORD=

# Aktifkan fitur (default: true). Set "false" untuk menonaktifkan total.
MOVIEBOX_OPENSUBTITLES_ENABLED=true

# Daftar bahasa dipisah koma, urutan prioritas (default: id,en)
MOVIEBOX_OPENSUBTITLES_LANGUAGES=id,en

# Opsional: override endpoint API (untuk pengujian/mirror). Kosongkan = default resmi.
# MOVIEBOX_OPENSUBTITLES_BASE_URL=

# ============================================================
#  MovieBox-Tui — SubDL (subtitle Indonesia, gratis, fallback)
#  Provider subtitle alternatif GRATIS sebagai fallback
#  sebelum OpenSubtitles (hemat kuota OS).
#  Registrasi gratis: https://subdl.com (API key di dashboard)
# ============================================================

# API key SubDL (WAJIB agar provider aktif; kosong = fitur mati)
MOVIEBOX_SUBDL_API_KEY=

# Aktifkan fitur (default: true). Set "false" untuk menonaktifkan.
MOVIEBOX_SUBDL_ENABLED=true

# Daftar bahasa dipisah koma (default: id,en)
MOVIEBOX_SUBDL_LANGUAGES=id,en

# Opsional: override endpoint API. Kosongkan = default resmi.
# MOVIEBOX_SUBDL_BASE_URL=

# ============================================================
#  MovieBox-Tui — Embedded subtitle (4KHDHub, opsional)
#  Deteksi track subtitle embedded di dalam file MKV/MP4
#  menggunakan ffprobe (perlu ffprobe di PATH). Default: false.
# ============================================================

# Set "true" untuk mengaktifkan probing ffprobe
# MOVIEBOX_PROBE_EMBEDDED_SUBTITLES=false
